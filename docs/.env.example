# Docs site environment variables.
#
# This file is for the docs subproject only. The parent project's .env at the
# repo root has its own variables — they don't propagate to this subproject.

# Site environment identifier
NUXT_SITE_ENV=staging                                    # staging | production

# Public docs URL (used for SEO canonical, OG images)
NUXT_SITE_URL=https://localhost:3001
