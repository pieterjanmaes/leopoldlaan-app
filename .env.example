# ─────────────────────────────────────────────────────────────────────────────
# .env.example
#
# Three categories of variables:
#
#   A. BUILD-TIME (public)    Baked into the client bundle during `nuxt build`.
#                              Set in GitHub Actions "Repository variables".
#
#   B. RUNTIME (server secret) Used by server endpoints only. Set in Cloudflare
#                              via `wrangler secret put`. Never bake into the
#                              client bundle. Local dev fills them from this
#                              .env file.
#
#   C. CI/CD                  Used by GitHub Actions to deploy. Set in GitHub
#                              Actions "Repository secrets/variables". NOT used
#                              by the app at runtime.
#
# For LOCAL development, all variables can live in .env (this file). For
# DEPLOYED environments, follow the categories above.
# ─────────────────────────────────────────────────────────────────────────────


# ── A. BUILD-TIME (public / non-sensitive) ───────────────────────────────────
# Set in: .env (local) / GitHub Actions vars (deployed)
# Baked into the client bundle at build time.

# Environment identifier (controls robots.txt allow/disallow)
NUXT_SITE_ENV=staging                    # staging | production

# Public site URL — used for SEO canonical URLs, sitemap, OG images
NUXT_SITE_URL=https://localhost:3000

# Cloudflare Turnstile site key (public, paired with secret below)
# For local development, use test keys:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google Tag Manager container ID (optional)
NUXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# Userback widget token (optional, public feedback widget)
NUXT_PUBLIC_USERBACK_TOKEN=


# ── B. RUNTIME (server secrets — sensitive) ──────────────────────────────────
# Set in: .env (local) / Cloudflare via `wrangler secret put` (deployed)
# These should NEVER be in .env.preview or .env.production committed values.
# Local dev reads them from this file.
#
# To set in Cloudflare:
#   wrangler secret put NUXT_SESSION_PASSWORD                # production
#   wrangler secret put NUXT_SESSION_PASSWORD --env preview  # preview

# Session encryption secret — 32+ random characters
NUXT_SESSION_PASSWORD=

# OG image signing secret — used by nuxt-og-image for signed URLs
NUXT_OG_IMAGE_SECRET=

# Cloudflare Turnstile secret key — used server-side to verify tokens
# LOCAL DEV ONLY: the test key below pairs with the test site key above.
# In Cloudflare, set the real secret via `wrangler secret put`.
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Gate key for /api/seed in non-dev environments
# (Dev mode allows /api/seed without it. In preview/production, requests must
# include this value to invoke the endpoint.)
SEED_KEY=


# ── C. CI/CD (not used by the app) ───────────────────────────────────────────
# Set ONLY in GitHub Actions repository secrets/variables — not in .env.
#
#   Repository secrets:
#     CLOUDFLARE_API_TOKEN          API token with Workers + D1 deploy scope
#     NUXT_SESSION_PASSWORD         mirrored from B if you want build-time default
#     NUXT_TURNSTILE_SECRET_KEY     mirrored from B if you want build-time default
#     NUXT_OG_IMAGE_SECRET          mirrored from B if you want build-time default
#     SEED_KEY                      mirrored from B if you want build-time default
#
#   Repository variables:
#     CLOUDFLARE_ACCOUNT_ID         your Cloudflare account ID
#     NUXT_SITE_URL                 environment-specific URL
#     NUXT_PUBLIC_TURNSTILE_SITE_KEY
#     NUXT_PUBLIC_USERBACK_TOKEN
#     NUXT_PUBLIC_GOOGLE_TAG_MANAGER_ID
#     GOOGLE_TAG_MANAGER_ID
#
# The deploy workflows in .github/workflows/deploy-*.yml read these and pass
# them into the build. Cloudflare Wrangler secrets then override the
# server-only values at runtime.
