{
	"name": "leopoldlaan-app",
	"private": true,
	"author": "Who Owns The Zebra",
	"type": "module",
	"scripts": {
		"build": "NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "oxlint --type-aware --type-check && eslint .",
		"lint:fix": "oxlint --type-aware --type-check --fix && eslint . --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"deploy:preview": "wrangler deploy --config wrangler.jsonc --env preview",
		"deploy:production": "wrangler deploy --config wrangler.jsonc",
		"build:deploy:preview": "dotenv -e .env.preview -- pnpm run build && wrangler deploy --config wrangler.jsonc --env preview",
		"build:deploy:production": "dotenv -e .env.production -- pnpm run build && wrangler deploy --config wrangler.jsonc"
	},
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"konva": "^10.9.0",
		"vue-konva": "^4.0.1",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@iconify-json/flagpack": "^1.2.8",
		"@iconify-json/lucide": "^1.2.145",
		"@libsql/client": "^0.18.0",
		"@nuxt/eslint": "^1.17.0",
		"@nuxt/eslint-plugin": "^1.17.0",
		"@nuxt/image": "^2.1.0",
		"@nuxt/scripts": "^1.3.12",
		"@nuxt/test-utils": "^4.3.4",
		"@nuxt/ui": "^4.12.0",
		"@nuxthub/core": "^0.10.8",
		"@nuxtjs/i18n": "^10.6.0",
		"@nuxtjs/seo": "^6.0.1",
		"@nuxtjs/turnstile": "^1.1.3",
		"@paralleldrive/cuid2": "^3.3.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"@types/sortablejs": "^1.15.9",
		"@userback/widget": "^0.3.13",
		"@vue/test-utils": "^2.5.1",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "^15.0.0",
		"@wotzebra/oxc-config": "github:wotzebra/oxc-config",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^18.0.8",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-oxlint": "^1.88.0",
		"happy-dom": "^21.0.3",
		"libphonenumber-js": "^1.13.15",
		"nuxt": "^4.6.2",
		"nuxt-auth-utils": "^0.5.32",
		"nuxt-security": "^2.6.0",
		"oxc-nuxt": "^0.1.5",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"sass": "^1.105.2",
		"satori": "^0.47.1",
		"sortablejs": "^1.15.7",
		"tailwindcss": "^4.3.3",
		"ufo": "^1.6.4",
