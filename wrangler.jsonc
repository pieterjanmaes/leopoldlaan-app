{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "leopoldlaan-app",
	"account_id": "f489d39130abffc57f47191c27cd2e8f",
	"main": "./.output/server/index.mjs",
	"compatibility_date": "2026-04-02",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"assets": {
		"directory": "./.output/public/",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "leopoldlaan-app",
			// Create with `wrangler d1 create leopoldlaan-app` and paste the id here.
			"database_id": "REPLACE_WITH_D1_ID"
		}
	],
	"vars": {},
	// Secrets (sensitive data - use `wrangler secret put <NAME>`)
	// Run these commands to add secrets to production:
	//
	// wrangler secret put NUXT_TURNSTILE_SECRET_KEY
	// wrangler secret put NUXT_SESSION_PASSWORD
	// wrangler secret put SEED_KEY
	// wrangler secret put NUXT_OAUTH_GOOGLE_CLIENT_ID
	// wrangler secret put NUXT_OAUTH_GOOGLE_CLIENT_SECRET
	// wrangler secret put NUXT_DRIVE_TOKEN_KEY
	//
	// For preview environment, add secrets with --env preview:
	//
	// wrangler secret put NUXT_TURNSTILE_SECRET_KEY --env preview
	// wrangler secret put NUXT_SESSION_PASSWORD --env preview
	// wrangler secret put SEED_KEY --env preview
	//
	// Environment-specific configurations
	"env": {
		"preview": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "leopoldlaan-app-preview",
					// Create with `wrangler d1 create leopoldlaan-app-preview` and paste the id here.
					"database_id": "REPLACE_WITH_D1_ID"
				}
			],
			"vars": {}
		}
	}
}
